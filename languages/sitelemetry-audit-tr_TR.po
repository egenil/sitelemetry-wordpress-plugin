msgstr "AI düzeltme promptunu kopyala"

#: admin/views/results.php:247
msgid "The prompt is built in wp-admin from this result and only copied to your clipboard. Nothing is sent."
msgstr "Prompt, wp-admin’de bu sonuçtan oluşturulur ve yalnızca panonuza kopyalanır. Hiçbir şey gönderilmez."

#: admin/views/results.php:249
msgid "Show the prompt"
msgstr "Promptu göster"

#: admin/views/results.php:250
msgid "AI fix prompt"
msgstr "AI düzeltme promptu"

#: admin/views/results.php:259
msgid "Pillar"
msgstr "Alan"

#: admin/views/results.php:261 admin/views/results.php:290
