#. translators: %s: audit job id.
#: admin/views/results.php:129
msgid "Job %s"
msgstr "İş %s"

#: admin/views/results.php:148
msgid "Open the app"
msgstr "Uygulamayı aç"

#: admin/views/results.php:156
msgid "Ownership verified"
msgstr "Sahiplik doğrulandı"

#: admin/views/results.php:158
msgid "Renew the ownership verification"
msgstr "Sahiplik doğrulamasını yenile"

#: admin/views/results.php:158
msgid "Verify ownership of the site"
msgstr "Sitenin sahipliğini doğrula"

#: admin/views/results.php:165
msgid "You can verify from WordPress with one click: Verify this site asks Sitelemetry for a verification code, publishes it for this site and completes the verification."
msgstr "WordPress’ten tek tıkla doğrulayabilirsiniz: “Bu siteyi doğrula” Sitelemetry’den bir doğrulama kodu ister, bu site için yayınlar ve doğrulamayı tamamlar."

#: admin/views/results.php:168
msgid "The stored token was used up by the last verification. In the app, click Reverify for this domain and copy the new token, save it under Verify this site (it replaces the old one), then click Verify HTTP in the app and run the audit again."
msgstr "Kayıtlı token son doğrulamada kullanıldı. Uygulamada bu alan adı için “Yeniden doğrula” düğmesine tıklayıp yeni token’ı kopyalayın, “Bu siteyi doğrula” bölümüne kaydedin (eskisinin yerini alır), ardından uygulamada “HTTP’yi doğrula” düğmesine tıklayın ve denetimi yeniden çalıştırın."

#: admin/views/results.php:170
msgid "This plugin already publishes a verification file for this site. Finish in the app: click Verify HTTP for this domain, then run the audit again."
msgstr "Bu eklenti bu site için zaten bir doğrulama dosyası yayınlıyor. İşlemi uygulamada tamamlayın: bu alan adı için “HTTP’yi doğrula” düğmesine tıklayın, ardından denetimi yeniden çalıştırın."

#: admin/views/results.php:172
msgid "You can verify from WordPress: paste the token from the app into the plugin settings and the plugin publishes the verification file for this site."
msgstr "Doğrulamayı WordPress’ten yapabilirsiniz: uygulamadaki token’ı eklenti ayarlarına yapıştırın; eklenti bu sitenin doğrulama dosyasını yayınlar."

#: admin/views/results.php:179
msgid "On a multisite network only a network administrator can publish the verification file for this site. Ask a network administrator, or verify the host in the app with a DNS record."
msgstr "Çoklu site ağında bu sitenin doğrulama dosyasını yalnızca bir ağ yöneticisi yayımlayabilir. Bir ağ yöneticisinden isteyin veya alan adını uygulamada bir DNS kaydıyla doğrulayın."

#: admin/views/results.php:182
msgid "The audited target is not this WordPress site, so the plugin cannot publish its verification file. Verify it in the app with a DNS record or an HTTP file on that site."
msgstr "Denetlenen hedef bu WordPress sitesi değil; eklenti doğrulama dosyasını yalnızca bu site için yayınlar. Hedefi uygulamada, o sitedeki bir DNS kaydı veya HTTP dosyasıyla doğrulayın."

#: admin/views/results.php:188
msgid "A verification lasts 30 days and is not renewed automatically. Before it expires, click Reverify in the app, publish the new token and verify again."
msgstr "Doğrulama 30 gün geçerlidir ve kendiliğinden yenilenmez. Süresi dolmadan önce uygulamada “Yeniden doğrula” düğmesine tıklayın, yeni token’ı yayınlayın ve tekrar doğrulayın."

#: admin/views/results.php:205 admin/views/results.php:260
msgid "Score"
msgstr "Puan"

