#. Plugin Name of the plugin
#: sitelemetry-audit.php
msgid "Sitelemetry Audit – Security, SEO & AI Readiness Scanner"
msgstr "Sitelemetry Audit – Güvenlik, SEO ve AI Hazırlığı Tarayıcısı"

#. Plugin URI of the plugin
#: sitelemetry-audit.php
msgid "https://github.com/egenil/sitelemetry-wordpress-plugin"
msgstr "https://github.com/egenil/sitelemetry-wordpress-plugin"

#. Description of the plugin
#: sitelemetry-audit.php
msgid "Run Sitelemetry website audits (security first; SEO, performance, accessibility, AI visibility and integrations on paid plans) from the WordPress dashboard and review the findings with fixes."
msgstr "WordPress yönetim panelinden Sitelemetry web sitesi denetimleri çalıştırın (önce güvenlik; ücretli planlarda SEO, performans, erişilebilirlik, AI görünürlüğü ve entegrasyonlar) ve bulguları düzeltmeleriyle birlikte inceleyin."

#. Author URI of the plugin
#: sitelemetry-audit.php
msgid "https://sitelemetry.com"
msgstr "https://sitelemetry.com"

#: admin/views/dashboard-widget.php:18
msgid "Connect your Sitelemetry account to audit this site for security, SEO and performance issues."
msgstr "Bu siteyi güvenlik, SEO ve performans sorunları için denetlemek üzere Sitelemetry hesabınızı bağlayın."

