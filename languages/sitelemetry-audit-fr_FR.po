#. Plugin Name of the plugin
#: sitelemetry-audit.php
msgid "Sitelemetry Audit – Security, SEO & AI Readiness Scanner"
msgstr "Sitelemetry Audit – Scanner de sécurité, SEO et préparation à l’IA"

#. Plugin URI of the plugin
#: sitelemetry-audit.php
msgid "https://github.com/egenil/sitelemetry-wordpress-plugin"
msgstr "https://github.com/egenil/sitelemetry-wordpress-plugin"

#. Description of the plugin
#: sitelemetry-audit.php
msgid "Run Sitelemetry website audits (security first; SEO, performance, accessibility, AI visibility and integrations on paid plans) from the WordPress dashboard and review the findings with fixes."
msgstr "Lancez des audits Sitelemetry de votre site depuis le tableau de bord WordPress (la sécurité d’abord ; SEO, performance, accessibilité, visibilité IA et intégrations avec les offres payantes) et consultez les constats avec leurs correctifs."

#. Author URI of the plugin
#: sitelemetry-audit.php
msgid "https://sitelemetry.com"
msgstr "https://sitelemetry.com"

